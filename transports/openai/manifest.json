{
  "schema": 1,
  "id": "openai",
  "name": "OpenAI Secure MCP Tunnel",
  "version": "0.0.21",
  "type": "transport",
  "core": "mcp-stdio",
  "management": 1,
  "entry": "management/LDC-OpenAI.ps1",
  "dependencies": [],
  "permissions": ["outbound-https", "child-process"],
