<Window x:Class="LocalDC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Desktop Commander" Width="960" Height="700"
        MinWidth="720" MinHeight="520"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,7"/>
            <Setter Property="MinHeight" Value="33"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Width" Value="132"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
            <TextBlock Text="Local Desktop Commander" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding InstanceLabel}" Foreground="#526579" Margin="0,4,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="12" Margin="0,12,0,0"
                BorderBrush="#D6DFE9" BorderThickness="1" CornerRadius="5">
            <TextBlock Text="{Binding Message}"/>
        </Border>
        <TabControl x:Name="Pages" TabStripPlacement="Left" Background="Transparent"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="0">
            <TabItem Header="服务概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="服务状态" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActualState}" FontSize="28" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding ActualDetails}" Margin="0,0,0,12"/>
                        <WrapPanel IsEnabled="{Binding CanOperate}">
                            <Button Content="启动" Click="Start_Click" IsEnabled="{Binding CanStart}"/>
                            <Button Content="停止" Click="Stop_Click" IsEnabled="{Binding CanStop}"/>
                            <Button Content="重启" Click="Restart_Click" IsEnabled="{Binding CanStop}"/>
                        </WrapPanel>
                        <Button Content="刷新状态" Click="Refresh_Click" HorizontalAlignment="Left"/>
                        <Separator Margin="0,14,0,14"/>
                        <TextBlock Text="工具发现" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ToolDescription}" FontSize="17" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding ToolSummary}" Foreground="#526579"/>
                        <Separator Margin="0,14,0,14"/>
                        <TextBlock Text="连接层级" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LayerDetails}" Margin="0,9,0,0"/>
                        <Separator Margin="0,14,0,14"/>
                        <TextBlock Text="目标与回滚配置" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TargetDetails}" Margin="0,9,0,0"/>
                        <TextBlock Text="{Binding RestartNotice}" Foreground="#915400"/>
                        <Separator Margin="0,14,0,14"/>
                        <TextBlock Text="{Binding ConnectionDetails}"/>
                        <TextBlock Text="{Binding TaskDetails}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ObservedTime, StringFormat=状态采样：{0}}"
                                   Foreground="#526579" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="连接管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="连接与分层诊断" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InstanceLabel}" Foreground="#526579" Margin="0,8,0,12"/>
                        <TextBlock Text="{Binding LayerDetails}" FontSize="16"/>
                        <TextBlock Text="{Binding DiagnosticsAdvice}" Margin="0,9,0,9" Foreground="#526579"/>
                        <WrapPanel>
                            <Button Content="一键诊断（只读）" Click="Diagnose_Click" IsEnabled="{Binding CanOperate}"/>
                            <Button Content="受控重启当前实例" Click="Restart_Click" IsEnabled="{Binding CanStop}"/>
                        </WrapPanel>
                        <Separator Margin="0,13,0,13"/>
                        <TextBlock Text="运行健康状态" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding HealthDetails}" Margin="0,8,0,10"/>
                        <TextBlock Text="传输接口" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding TransportDetails}" Margin="0,8,0,10"/>
                        <TextBlock Text="本地 MCP 接入地址" FontSize="17" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Endpoint, Mode=OneWay}" IsReadOnly="True" Margin="0,7,0,7"
                                 TextWrapping="Wrap" Padding="8"/>
                        <Button Content="复制本地地址" Click="CopyEndpoint_Click"
                                IsEnabled="{Binding HasEndpoint}" HorizontalAlignment="Left"/>
                        <TextBlock Text="本地检测不等于 ChatGPT 或 Gemini 远程调用已验证。"
                                   Foreground="#526579" Margin="0,5,0,8"/>
                        <Separator Margin="0,10,0,10"/>
                        <TextBlock Text="日志位置（只读）" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LogDetails}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="工具管理">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="MCP 工具实际发现" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ToolDescription}" FontSize="18" Margin="0,9,0,4"/>
                        <TextBlock Text="{Binding ToolSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ToolCheckedAt, StringFormat=检测时间：{0}}"
                                   Foreground="#526579" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Row="1" Content="重新检测工具" Click="DetectTools_Click"
                            IsEnabled="{Binding CanOperate}" HorizontalAlignment="Left" Margin="0,12,0,12"/>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="ToolSearch" Width="260" MinHeight="32" Padding="7"
                                 TextChanged="ToolSearch_Changed" ToolTip="按工具名称查找"/>
                        <ComboBox x:Name="ToolCategory" Width="155" Margin="10,0,0,0"
                                  SelectionChanged="ToolCategory_Changed">
                            <ComboBoxItem Content="全部" IsSelected="True"/>
                            <ComboBoxItem Content="文件工具"/>
                            <ComboBoxItem Content="终端工具"/>
                            <ComboBoxItem Content="异常"/>
                        </ComboBox>
                    </WrapPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Tools}" BorderBrush="#D6DFE9">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0"
                                               FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#526579" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="运行设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="运行配置" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TargetDetails}" Margin="0,10,0,8"/>
                        <StackPanel IsEnabled="{Binding CanOperate}">
                            <TextBlock Text="工具模式" FontWeight="SemiBold" Margin="0,10,0,6"/>
                            <ComboBox x:Name="ToolMode" Width="305" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="files" Content="文件模式 · 14 项工具"/>
                                <ComboBoxItem Tag="terminal" Content="完整终端模式 · 21 项工具"/>
                            </ComboBox>
                            <TextBlock Text="终端使用当前 Windows 用户权限，不受文件授权根限制。"
                                       Foreground="#526579" Margin="0,6"/>
                            <TextBlock Text="文件访问权限" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <ComboBox x:Name="AccessMode" Width="305" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="restricted" Content="Restricted · 受限访问"/>
                                <ComboBoxItem Tag="full" Content="Full · 完整文件访问"
                                              IsEnabled="{Binding FullAvailable}"/>
                            </ComboBox>
                            <TextBlock Text="{Binding FullNotice}" Foreground="#526579" Margin="0,6"/>
                            <TextBlock Text="授权根目录（Full 下保留）"
                                       FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="浏览" Click="Browse_Click"/>
                                <TextBox x:Name="RootPath" Padding="7"/>
                            </DockPanel>
                            <TextBlock Text="权限或根目录修改须先停止实例，下次启动生效。"
                                       Foreground="#526579" Margin="0,8"/>
                            <WrapPanel Margin="0,15,0,0">
                                <Button Content="读取当前配置" Click="Load_Click"/>
                                <Button Content="保存配置" Click="Save_Click"/>
                                <Button Content="保存并启动" Click="SaveStart_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
