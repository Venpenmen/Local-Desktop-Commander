<Window x:Class="LocalDC.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local Desktop Commander" Width="920" Height="650" MinWidth="720" MinHeight="520" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F4F6F8">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></Window.Resources>
<DockPanel Margin="24">
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Local Desktop Commander" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding InstanceLabel}" Foreground="#526579"/></StackPanel>
<Border DockPanel.Dock="Bottom" Background="White" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Message}"/></Border>
<TabControl TabStripPlacement="Left">
<TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="服务状态" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ActualState}" FontSize="30" Margin="0,12"/><TextBlock Text="{Binding ActualDetails}" Margin="0,0,0,12"/>
<WrapPanel IsEnabled="{Binding CanOperate}"><Button Content="启动" Click="Start_Click" IsEnabled="{Binding CanStart}"/><Button Content="停止" Click="Stop_Click" IsEnabled="{Binding CanStop}"/><Button Content="重启" Click="Restart_Click" IsEnabled="{Binding CanStop}"/></WrapPanel>
<Button Content="刷新" Click="Refresh_Click" HorizontalAlignment="Left" Margin="0,8"/>
<Separator Margin="0,20"/><TextBlock Text="目标配置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TargetDetails}" Margin="0,10"/><TextBlock Text="{Binding RestartNotice}" Foreground="#915400"/>
<Separator Margin="0,20"/><TextBlock Text="连接与最近任务" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionDetails}" Margin="0,10"/><TextBlock Text="{Binding TaskDetails}"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="运行配置" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding TargetDetails}" Margin="0,10"/>
<StackPanel IsEnabled="{Binding CanOperate}">
<TextBlock Text="工具模式" FontWeight="SemiBold" Margin="0,12,0,6"/>
<ComboBox x:Name="ToolMode" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag"><ComboBoxItem Tag="files" Content="文件模式 · 14 项工具"/><ComboBoxItem Tag="terminal" Content="完整终端模式 · 21 项工具"/></ComboBox>
<TextBlock Text="终端使用当前 Windows 用户权限，不受文件授权根限制。" Foreground="#526579" Margin="0,6"/>
<TextBlock Text="文件访问权限" FontWeight="SemiBold" Margin="0,12,0,6"/><ComboBox x:Name="AccessMode" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag"><ComboBoxItem Tag="restricted" Content="Restricted · 受限访问"/><ComboBoxItem Tag="full" Content="Full · 完整文件访问" IsEnabled="{Binding FullAvailable}"/></ComboBox><TextBlock Text="{Binding FullNotice}" Foreground="#526579" Margin="0,6"/>
<TextBlock Text="授权根目录（Full 下保留）" FontWeight="SemiBold" Margin="0,12,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="Browse_Click"/><TextBox x:Name="RootPath" Padding="6"/></DockPanel>
<TextBlock Text="权限或根目录修改须先停止实例，下次启动生效。" Foreground="#526579" Margin="0,8"/>
<WrapPanel Margin="0,15"><Button Content="读取当前配置" Click="Load_Click"/><Button Content="保存配置" Click="Save_Click"/><Button Content="保存并启动" Click="SaveStart_Click"/></WrapPanel>
</StackPanel></StackPanel></ScrollViewer></TabItem>
</TabControl></DockPanel></Window>